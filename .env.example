# Copy this file to `.env` and fill in your own Supabase project's values.
# Find them in your Supabase project: Settings → API.
#
# Vite only exposes env vars prefixed with VITE_ to the browser bundle, so
# keep that prefix. The anon/public key is safe to ship to the browser —
# it's designed for that — access is controlled by the Row Level Security
# policies in supabase/schema.sql, not by keeping this key secret.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
